{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "small",
        "color": {
            "1": "blue"
        },
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "blue"
        }
    },
    "modules": [
        "title",
        {
            "type": "os",
            "key": "OS",
            "format": "Fedora"
        },
        "kernel",
        "wm",
        "cpu",
        "memory",
	"uptime",
        "break"
    ]
}
