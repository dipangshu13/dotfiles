# Font and Colors (Matching your Waybar setup)
font=Noto Sans Mono 10
background-color=#001122
text-color=#ffffff
border-color=#0055aa
progress-color=over #0055aa

# Layout
width=350
height=150
margin=10
padding=15
border-size=2
border-radius=10

# Behavior
anchor=top-right
default-timeout=5000
ignore-timeout=0
max-visible=3
layer=overlay

# Grouping (Stacks notifications instead of overlapping)
group-by=app-name
format=<b>%a</b>\n%b
